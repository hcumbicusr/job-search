{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "module":"commonjs",
    "target": "ES2021",
    "types": ["node","jest"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*.ts", "prisma/prisma.config.ts"],
  "exclude": ["node_modules", "public_html","test","dist"]
}
